<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_settings"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ink_2" />

        <TextView
            style="@style/TideText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:text="@string/home_settings" />

        <TextView
            android:id="@+id/btn_save_persona"
            style="@style/TideText.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/admin_save" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ProgressBar
        android:id="@+id/progress_settings"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/teal"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/page_pad_wide"
            android:paddingTop="20dp"
            android:paddingRight="@dimen/page_pad_wide"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/ai_avatar_frame"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_avatar_soft"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ai_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/admin_ai_avatar"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/ai_avatar_initial"
                    style="@style/TideText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/paper"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                style="@style/TideText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_ai_name" />

            <EditText
                android:id="@+id/input_ai_name"
                style="@style/TideInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:hint="@string/admin_ai_name"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                style="@style/TideText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/admin_ai_signature" />

            <EditText
                android:id="@+id/input_ai_signature"
                style="@style/TideInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:hint="@string/admin_ai_signature"
                android:inputType="text"
                android:maxLength="200"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                style="@style/TideText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/admin_persona_label" />

            <EditText
                android:id="@+id/input_persona"
                style="@style/TideInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="@string/admin_persona_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="8"
                android:padding="14dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/text_settings_error"
                style="@style/TideText.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:minHeight="20dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
