<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ink_2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                style="@style/TideText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/text_conn"
                style="@style/TideText.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/chat_connecting" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_search"
            android:padding="13dp"
            android:src="@drawable/ic_search"
            android:tint="@color/ink_2" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_more"
            android:padding="12dp"
            android:src="@drawable/ic_more"
            android:tint="@color/ink_2" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/text_announcement"
        style="@style/TideText.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_alt"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="1"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ink_2"
        android:visibility="gone" />

    <View
        android:id="@+id/divider_announcement"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_alt"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <View
            android:layout_width="2dp"
            android:layout_height="30dp"
            android:background="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reply_title"
                style="@style/TideText.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reply_text"
                style="@style/TideText.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_2" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_reply_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_reply_cancel"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/ink_3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_send_voice"
            android:padding="9dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/ink_2" />

        <EditText
            android:id="@+id/input_message"
            style="@style/TideText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/hint_message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:layout_marginLeft="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_more"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            android:tint="@color/ink_2" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_send_dis"
            android:contentDescription="@string/chat_send"
            android:enabled="false"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:tint="@color/paper" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attach_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/attach_sticker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/attach_sticker"
                    android:src="@drawable/ic_sticker"
                    android:tint="@color/ink_2" />

                <TextView
                    style="@style/TideText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/attach_sticker"
                    android:textColor="@color/ink_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attach_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/attach_image"
                    android:src="@drawable/ic_image"
                    android:tint="@color/ink_2" />

                <TextView
                    style="@style/TideText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/attach_image"
                    android:textColor="@color/ink_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attach_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/attach_file"
                    android:src="@drawable/ic_file_attach"
                    android:tint="@color/ink_2" />

                <TextView
                    style="@style/TideText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/attach_file"
                    android:textColor="@color/ink_2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sticker_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/sticker_tab_recent"
                style="@style/TideText.Body"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/sticker_recent"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sticker_tab_all"
                style="@style/TideText.Body"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/sticker_all"
                android:textColor="@color/ink_3" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_sticker_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sticker_close"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="@color/ink_3" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/sticker_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:horizontalSpacing="8dp"
                android:numColumns="4"
                android:padding="8dp"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="8dp" />

            <TextView
                android:id="@+id/sticker_empty"
                style="@style/TideText.Micro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/sticker_empty"
                android:textColor="@color/ink_3"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
