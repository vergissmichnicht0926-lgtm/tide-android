<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/TideText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/devices_approve_title" />

    <TextView
        style="@style/TideText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/devices_approve_hint" />

    <EditText
        android:id="@+id/input_code"
        style="@style/TideInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="16dp"
        android:digits="0123456789"
        android:gravity="center"
        android:hint="@string/devices_approve_hint"
        android:inputType="number"
        android:letterSpacing="0.12"
        android:maxLength="6"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text_code_error"
        style="@style/TideText.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/TideButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btn_approve"
            style="@style/TideButton.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="@string/devices_approve" />
    </LinearLayout>
</LinearLayout>
