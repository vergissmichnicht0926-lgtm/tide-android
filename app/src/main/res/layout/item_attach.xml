<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:minWidth="220dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/file_type"
        style="@style/TideText"
        android:layout_width="@dimen/type_badge"
        android:layout_height="@dimen/type_badge"
        android:background="@drawable/bg_type_badge"
        android:gravity="center"
        android:textColor="@color/teal_dark"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/file_name"
            style="@style/TideText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/file_meta"
            style="@style/TideText.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/file_action"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_download"
        android:tint="@color/ink_2" />
</LinearLayout>
