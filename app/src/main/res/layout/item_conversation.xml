<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/page_pad"
        android:paddingRight="@dimen/page_pad">

        <TextView
            android:id="@+id/conv_avatar"
            android:layout_width="@dimen/avatar_list"
            android:layout_height="@dimen/avatar_list"
            android:background="@drawable/bg_avatar_square_teal"
            android:gravity="center"
            android:textColor="@color/paper"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/conv_title"
                style="@style/TideText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conv_preview"
                style="@style/TideText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/conv_notice"
                style="@style/TideText"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="@string/chat_announcement"
                android:textColor="@color/teal_dark"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/conv_time"
                style="@style/TideText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/conv_badge"
                style="@style/TideText"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:textColor="@color/paper"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="78dp"
        android:layout_marginRight="@dimen/page_pad"
        android:background="@color/line2" />
</LinearLayout>
