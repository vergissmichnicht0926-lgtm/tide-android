<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="14dp"
    android:paddingRight="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/moment_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_soft"
            android:gravity="center"
            android:text="汐"
            android:textColor="@color/paper"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/moment_author"
                style="@style/TideText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/moment_text"
                style="@style/TideText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/moment_time"
                style="@style/TideText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_3" />

            <TextView
                android:id="@+id/moment_like"
                style="@style/TideText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_heart"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:minWidth="56dp"
                android:paddingRight="10dp"
                android:text="@string/moment_like"
                android:textColor="@color/ink_3" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
